# What a build of the Origin test package fetches from outside this repository, pinned, for packaging/fetch-deps.sh (which sources it: keep to
# NAME=value). Moving a pin is a change like any other: commit it with what it needs.

# Tools, installed under .tools/ when the machine has no suitable one
DOTNET_SDK_VERSION=10.0.403
NODE_VERSION=24.22.3

# The plugins, cloned into NINA.Plugins/ (a checkout already there is left alone, with a warning if it is elsewhere)
NINAAPI_URL=https://github.com/nitr57/ninaAPI
NINAAPI_COMMIT=f3ab4f052f72df78d88f0d29645924129d083dcc
TNS_PLUGIN_URL=https://github.com/jrrk2/N.I.N.A-Plugin-for-Touch-N-Stars
TNS_PLUGIN_COMMIT=2f37aa39ff30f47423c956d8c2d5e227076bfbb1

# The Touch-N-Stars frontend, built into the plugin's app/ folder (6.5.0-beta24, as in origin1-origin10)
TNS_APP_URL=https://github.com/Touch-N-Stars/Touch-N-Stars
TNS_APP_COMMIT=ee047432969b2a441bf4fa086b0b1067afc5e32c

# NINA/External: NOVAS and SOFA are built from this repository; these are the rest. OpenCvSharpExtern is built from the opencvsharp tag that
# matches the OpenCvSharp4 package in NINA/NINA.csproj, against the distribution's OpenCV.
JPLEPH_URL=https://github.com/isbeorn/nina.external/raw/7cd8d0ae5338f1ff41c044c097f4b973dd319286/JPLEPH
EXTERNAL_LICENSE_URL=https://raw.githubusercontent.com/nitr57/pins.external/84ca364409cf7346b8698e52b946d21498a5d102/LICENSE.txt

# OriginSimulator, for make release-test and make test-sim, cloned into artifacts/src/OriginSimulator
SIM_URL=https://github.com/jrrk2/OriginSimulator
SIM_COMMIT=ca34faca174841c95315eade353e34a2d8766b34
